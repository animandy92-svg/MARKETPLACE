{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"], "skipLibCheck": true, "allowSyntheticDefaultImports": true,
    "esModuleInterop": true, "noEmit": true, "strict": false, "resolveJsonModule": true, "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
