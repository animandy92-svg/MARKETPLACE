{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate": "node migrate-to-firestore.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^18.19.0"
  },
  "private": true,
  "overrides": { "gaxios": { "uuid": "^11.1.1" } }
}
